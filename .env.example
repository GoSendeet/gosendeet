# Required
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_GOOGLE_MAPS_KEY=your_google_maps_browser_key

# App environment: local, dev, staging, or production
VITE_APP_ENV=local

# Frontend URL used by documented callback/redirect flows
VITE_FRONTEND_BASE_URL=http://localhost:5173

# Optional feature flags
VITE_ENABLE_GOOGLE_AUTH=false
VITE_SHOW_FRANCHISE_FORM=false

# Optional support integrations
VITE_SUPPORT_WHATSAPP=2348000000000
VITE_CHATWOOT_BASE_URL=https://backoffice-customer-support.gosendeet.com
VITE_CHATWOOT_WEBSITE_TOKEN=your_chatwoot_website_token

# Optional analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
